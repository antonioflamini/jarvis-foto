  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "node test/collaudo.js"
  },
  "author": "Antonio Flamini",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "archiver": "^8.0.0",
    "exifr": "^7.1.3",
